+    return (s->sym_next == s->sym_end);
@@ -1072 +1050 @@ local void compress_block(s, ltree, dtree)
-    unsigned lx = 0;    /* running index in l_buf */
+    unsigned sx = 0;    /* running index in sym_buf */
@@ -1076,3 +1054,4 @@ local void compress_block(s, ltree, dtree)
-    if (s->last_lit != 0) do {
-        dist = s->d_buf[lx];
