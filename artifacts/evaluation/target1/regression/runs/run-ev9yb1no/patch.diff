@@ -1103,3 +1082,2 @@ local void compress_block(s, ltree, dtree)
-        /* Check that the overlay between pending_buf and d_buf+l_buf is ok: */
-        Assert((uInt)(s->pending) < s->lit_bufsize + 2*lx,
