--- a/trees.c
+++ b/trees.c
@@ -419 +419 @@ local void init_block(s)
-    s->last_lit = s->matches = 0;
+    s->sym_next = s->matches = 0;
@@ -951 +951 @@ void ZLIB_INTERNAL _tr_flush_block(s, buf, stored_len, last)
-                s->last_lit));
+                s->sym_next / 3));
@@ -1020,2 +1020,3 @@ int ZLIB_INTERNAL _tr_tally (s, dist, lc)
-    s->d_buf[s->last_lit] = (ush)dist;
-    s->l_buf[s->last_lit++] = (uch)lc;
